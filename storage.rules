rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function owner(uid) { return request.auth != null && request.auth.uid==uid && (!firestore.exists(/databases/(default)/documents/users/$(uid)) || !firestore.get(/databases/(default)/documents/users/$(uid)).data.get('deleting',false)); }
  match /users/{uid}/media/{id} {
   allow read: if owner(uid);
   allow write: if owner(uid) && id.matches('[a-f0-9-]{36}')
    && request.resource != null && request.resource.size<=20*1024*1024
    && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
  }
 }
}
